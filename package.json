{
  "name": "hh-ultron",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "description": "3\\/11 QoL for KK games",
  "author": "Iron Man",
  "repository": {
    "type": "git",
    "url": "https://github.com/Iron-Man-Mk85/hh-ultron.git"
  },
  "engines": {
    "node": ">=20"
  },
  "userscript": {
    "name": "HH Ultron",
